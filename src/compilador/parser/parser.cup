package compilador.parser;

import java_cup.runtime.*;
import java.util.*;
import compilador.semantic.ErrorReporter;

parser code {:
  // Chamado sempre que o CUP encontra um erro de sintaxe
  public void syntax_error(java_cup.runtime.Symbol cur_token) {
      String text = (cur_token.value != null)
              ? cur_token.value.toString()
              : cur_token.toString();

      String msg = "token inesperado '" + text + "'";
      ErrorReporter.syntaxError(cur_token.left, cur_token.right, msg);
  }
:};

// ---- Terminais (tokens do lexer) ----

terminal INICIO, FIM, INTEIRO, REAL, IMPRIMA;
terminal String IDENT;
terminal Integer NUM_INT;
terminal Double  NUM_REAL;
terminal PLUS, MINUS, TIMES, DIV;
terminal ATRIB;
terminal SEMI, LPAREN, RPAREN, DOT, COMMA;

// ---- Não-terminais com tipos Java ----

non terminal Program program;
non terminal java.util.List<Decl> decl_list;
non terminal java.util.List<String> ident_list;
non terminal java.util.List<Stmt> stmt_list;
non terminal Stmt stmt;
non terminal Expr expr;
non terminal Expr term;
non terminal Expr factor;

// start
start with program;

// ---- Gramática ----

// programa: inicio <decls> <stmts> fim .
program ::=
    INICIO decl_list:ds stmt_list:ss FIM DOT
    {: RESULT = new Program(ds, ss); :}
;

// lista de declarações (pode ser vazia)
decl_list ::=
      decl_list:ds INTEIRO ident_list:ids SEMI
      {: 
         for (String id : ids) {
           ds.add(new Decl(TypeNode.INT, id, 0, 0));
         }
         RESULT = ds; 
      :}
    | decl_list:ds REAL ident_list:ids SEMI
      {: 
         for (String id : ids) {
           ds.add(new Decl(TypeNode.REAL, id, 0, 0));
         }
         RESULT = ds; 
      :}
    | /* vazio */
      {: RESULT = new java.util.ArrayList<Decl>(); :}
;

// lista de identificadores separados por vírgula
ident_list ::=
      ident_list:ids COMMA IDENT:id
      {: ids.add(id); RESULT = ids; :}
    | IDENT:id
      {: 
         java.util.List<String> ids = new java.util.ArrayList<>();
         ids.add(id);
         RESULT = ids;
      :}
;

// REMOVER regra decl antiga - não precisamos mais dela


// lista de comandos (pode ser vazia)
stmt_list ::=
      stmt_list:ss stmt:s
      {: ss.add(s); RESULT = ss; :}
    | /* vazio */
      {: RESULT = new java.util.ArrayList<Stmt>(); :}
;

// comandos:
//   x := expr;
//   imprima(expr);
stmt ::=
      IDENT:id ATRIB expr:e SEMI
      {: RESULT = new AssignStmt(id, e, idleft, idright); :}
    | IMPRIMA:imp LPAREN expr:e RPAREN SEMI
      {: RESULT = new PrintStmt(e, impleft, impright); :}
;

// EXPRESSÕES COM PRECEDÊNCIA:
// expr  -> expr + term | expr - term | term
// term  -> term * factor | term / factor | factor
// factor -> NUM_INT | NUM_REAL | IDENT | (expr)

expr ::=
      expr:e1 PLUS:op term:t
      {: RESULT = new BinExpr("+", e1, t, opleft, opright); :}
    | expr:e1 MINUS:op term:t
      {: RESULT = new BinExpr("-", e1, t, opleft, opright); :}
    | term:t
      {: RESULT = t; :}
;

term ::=
      term:t TIMES:op factor:f
      {: RESULT = new BinExpr("*", t, f, opleft, opright); :}
    | term:t DIV:op factor:f
      {: RESULT = new BinExpr("/", t, f, opleft, opright); :}
    | factor:f
      {: RESULT = f; :}
;

factor ::=
      NUM_INT:n
      {: RESULT = new IntLiteral(n, nleft, nright); :}
    | NUM_REAL:r
      {: RESULT = new RealLiteral(r, rleft, rright); :}
    | IDENT:id
      {: RESULT = new VarExpr(id, idleft, idright); :}
    | LPAREN expr:e RPAREN
      {: RESULT = e; :}  // expr já tem posição própria
;

